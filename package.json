{
  "name": "html-designer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Godot 锚点式 UI 编辑器，导出纯 CSS 的单 HTML 文件",
  "main": "electron/main.cjs",

  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "pack": "npm run build && electron-builder"
  },

  "build": {
    "appId": "com.sazuya.html-designer",
    "productName": "HTML Designer",
    "forceCodeSigning": false,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable"
    },
    "linux": {
      "target": "AppImage"
    }
  },

  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.0.0"
  },

  "dependencies": {
    "jszip": "^3.10.1"
  }
}
